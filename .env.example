# Copy to .env for local development — never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Optional: Neon / Postgres. If unset, SQLite is used locally.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# docker compose (Postgres 16) default:
# DATABASE_URL=postgresql://calllog:calllogpass@db:5432/call_logging

# Production only: set to 1 temporarily if you need the HTTP /seed endpoint.
# ENABLE_SEED=0

# Optional shared secret required by /seed when set (header X-Seed-Token or ?token=).
# SEED_TOKEN=

# Max request body size in bytes (CSV import and other uploads). Default 2 MiB.
# MAX_CONTENT_LENGTH=2097152
# MAX_IMPORT_BYTES=2097152
