# Copy to .env for local development — never commit real secrets.

SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# Optional: Neon / Postgres. If unset, SQLite is used locally.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Production only: set to 1 temporarily if you need the HTTP /seed endpoint.
# ENABLE_SEED=0

# Optional shared secret required by /seed when set (header X-Seed-Token or ?token=).
# SEED_TOKEN=
